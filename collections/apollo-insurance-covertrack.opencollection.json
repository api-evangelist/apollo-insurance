        "url": "https://api.covertrack.ca/compliance/:partnerId/:propertyId/:tenantId",
        "headers": [
          {
            "name": "x-api-key",
            "value": ""
          }
        ],
        "params": [
          {
            "name": "partnerId",
            "value": "",
            "type": "path",
            "description": "The Partner name"
          },
          {
            "name": "propertyId",
            "value": "",
            "type": "path",
            "description": "The Property ID, or \"P-Code\""
          },
          {
            "name": "tenantId",
